{
  "name": "@crawlora-org/kick",
  "version": "0.1.0",
  "description": "Crawlora Kick API client with 21 endpoints for channels, livestreams, clips, categories, search, and public mobile-app catalogues",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=kick-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-kick/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "kick", "kick-api", "kick-scraper", "kick-data", "kick-channels", "kick-livestreams", "kick-clips", "kick-categories", "kick-search"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-kick",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
